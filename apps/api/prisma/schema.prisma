generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BilanType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  courses     Course[]

  @@index([tenantId], map: "idx_bilan_types_tenant_id")
  @@index([createdAt], map: "idx_bilan_types_created_at")
  @@map("bilan_types")
}

model Programme {
  id       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  courses  Course[]

  @@map("programmes")
}

model Course {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  programmeId String    @map("programme_id") @db.Uuid
  bilanTypeId String    @map("bilan_type_id") @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id])
  bilanType   BilanType @relation(fields: [bilanTypeId], references: [id])

  @@index([programmeId], map: "idx_courses_programme_id")
  @@index([bilanTypeId], map: "idx_courses_bilan_type_id")
  @@map("courses")
}

model StudentPeriodAttendanceSummary {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  academicYearPeriodId String   @map("academic_year_period_id") @db.Uuid
  classId              String   @map("class_id") @db.Uuid
  studentId            String   @map("student_id") @db.Uuid
  absenceHours         Decimal  @default(0) @map("absence_hours") @db.Decimal(7, 2)
  justifiedHours       Decimal  @default(0) @map("justified_hours") @db.Decimal(7, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, academicYearPeriodId, classId, studentId], map: "student_period_attendance_summaries_unique")
  @@index([tenantId], map: "idx_sp_as_tenant")
  @@index([academicYearPeriodId], map: "idx_sp_as_period")
  @@index([classId], map: "idx_sp_as_class")
  @@index([studentId], map: "idx_sp_as_student")
  @@map("student_period_attendance_summaries")
}

enum DeliveryMode {
  PRESENTIAL @map("presential")
  REMOTE     @map("remote")
  HYBRID     @map("hybrid")
  ELEARNING  @map("elearning")

  @@map("delivery_mode")
}

enum SessionProfessionalStatus {
  PLANIFIEE @map("planifiee")
  OUVERTE   @map("ouverte")
  COMPLETE  @map("complete")
  EN_COURS  @map("en_cours")
  TERMINEE  @map("terminee")
  ANNULEE   @map("annulee")

  @@map("session_professional_status")
}

enum StatutInscription {
  EN_ATTENTE
  CONFIRME
  ANNULE

  @@map("statut_inscription")
}

model FormationProfessionnelle {
  id                  String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  titre               String                 @db.VarChar(255)
  slug                String?                @db.VarChar(255)
  descriptionCourte   String?                @map("description_courte") @db.Text
  descriptionComplete String?                @map("description_complete") @db.Text
  objectifs           Json?
  programmeDetaille   Json?                  @map("programme_detaille")
  prerequis           String?                @db.Text
  publicCible         String?                @map("public_cible") @db.Text
  dureeJours          Int?                   @map("duree_jours")
  dureeHeures         Int?                   @map("duree_heures")
  prixHt              Decimal?               @map("prix_ht") @db.Decimal(10, 2)
  prixTtc             Decimal?               @map("prix_ttc") @db.Decimal(10, 2)
  typeCertification   String?                @map("type_certification") @db.VarChar(100)
  nomCertification    String?                @map("nom_certification") @db.VarChar(255)
  brochurePdfUrl      String?                @map("brochure_pdf_url") @db.VarChar(500)
  themes              Json?
  niveau              String?                @db.VarChar(50)
  actif               Boolean?               @default(true)
  createdBy           String?                @map("created_by") @db.Uuid
  createdAt           DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?              @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions            SessionProfessionnelle[]
  inscriptions        InscriptionPublic[]
  supports            SupportCours[]

  @@unique([tenantId, slug], map: "formations_professionnelles_tenant_id_slug_key")
  @@map("formations_professionnelles")
}

model SessionProfessionnelle {
  id               String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  formationId      String                    @map("formation_pro_id") @db.Uuid
  codeSession      String?                   @map("code_session") @db.VarChar(50)
  dateDebut        DateTime                  @map("date_debut") @db.Date
  dateFin          DateTime                  @map("date_fin") @db.Date
  horaires         String?                   @db.VarChar(100)
  modeFormation    DeliveryMode              @map("mode_formation")
  lieu             String?                   @db.VarChar(500)
  lienVisio        String?                   @map("lien_visio") @db.VarChar(500)
  placesTotales    Int                       @map("places_totales")
  placesReservees  Int?                      @default(0) @map("places_reservees")
  prixHt           Decimal?                  @map("prix_ht") @db.Decimal(10, 2)
  prixTtc          Decimal?                  @map("prix_ttc") @db.Decimal(10, 2)
  statut           SessionProfessionalStatus @default(PLANIFIEE)
  notesInternes    String?                   @map("notes_internes") @db.Text
  createdAt        DateTime?                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  formation        FormationProfessionnelle  @relation(fields: [formationId], references: [id])
  sessionFormateurs SessionFormateur[]
  inscriptions     InscriptionPublic[]
  supports         SupportCours[]
  supportAssociations SupportSessionAssociation[]

  @@unique([tenantId, codeSession], map: "sessions_professionnelles_tenant_id_code_session_key")
  @@map("sessions_professionnelles")
}

model Formateur {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  civilite         String?           @db.VarChar(20)
  nom              String            @db.VarChar(100)
  prenom           String            @db.VarChar(100)
  email            String            @db.VarChar(255)
  telephone        String?           @db.VarChar(20)
  specialites      Json?
  bio              String?           @db.Text
  cvUrl            String?           @map("cv_url") @db.VarChar(500)
  photoUrl         String?           @map("photo_url") @db.VarChar(500)
  linkedInUrl      String?           @map("linkedin_url") @db.VarChar(500)
  tarifJournalier  Decimal?          @map("tarif_journalier") @db.Decimal(10, 2)
  actif            Boolean?          @default(true)
  createdAt        DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?         @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessionFormateurs SessionFormateur[]
  supports         SupportCours[]

  @@unique([tenantId, email], map: "formateurs_tenant_id_email_key")
  @@map("formateurs")
}

model SessionFormateur {
  id         String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String                @map("tenant_id") @db.Uuid
  sessionId  String                @map("session_id") @db.Uuid
  formateurId String               @map("formateur_id") @db.Uuid
  role       String?               @db.VarChar(50)
  createdAt  DateTime?             @default(now()) @map("created_at") @db.Timestamptz(6)
  session    SessionProfessionnelle @relation(fields: [sessionId], references: [id])
  formateur  Formateur             @relation(fields: [formateurId], references: [id])

  @@unique([tenantId, sessionId, formateurId], map: "session_formateurs_tenant_id_session_id_formateur_id_key")
  @@map("session_formateurs")
}

model PublicUser {
  id             String              @id @default(cuid())
  email          String              @unique
  emailVerified  DateTime?           @map("email_verified")
  nom            String?
  prenom         String?
  telephone      String?
  avatarUrl      String?             @map("avatar_url")
  motDePasseHash String?             @map("mot_de_passe_hash")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  accounts       Account[]
  sessions       UserSession[]
  inscriptions   InscriptionPublic[]

  @@map("public_users")
}

model Account {
  id                String     @id @default(cuid())
  userId            String     @map("user_id")
  type              String
  provider          String
  providerAccountId String     @map("provider_account_id")
  refreshToken      String?    @map("refresh_token")
  accessToken       String?    @map("access_token")
  expiresAt         Int?       @map("expires_at")
  tokenType         String?    @map("token_type")
  scope             String?
  idToken           String?    @map("id_token")
  sessionState      String?    @map("session_state")
  user              PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model UserSession {
  id           String     @id @default(cuid())
  sessionToken String     @unique @map("session_token")
  userId       String     @map("user_id")
  expires      DateTime
  user         PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model InscriptionPublic {
  id                String                  @id @default(cuid())
  userId            String                  @map("user_id")
  formationId       String                  @map("formation_id") @db.Uuid
  sessionId         String?                 @map("session_id") @db.Uuid
  statut            StatutInscription       @default(EN_ATTENTE)
  montantPaye       Decimal                 @map("montant_paye") @db.Decimal(10, 2)
  codePaiement      String                  @unique @map("code_paiement")
  referencePaiement String?                 @map("reference_paiement")
  moyenPaiement     String?                 @map("moyen_paiement")
  dateInscription   DateTime                @default(now()) @map("date_inscription")
  dateConfirmation  DateTime?               @map("date_confirmation")
  user              PublicUser              @relation(fields: [userId], references: [id])
  formation         FormationProfessionnelle @relation(fields: [formationId], references: [id])
  session           SessionProfessionnelle?  @relation(fields: [sessionId], references: [id])

  @@index([userId], map: "idx_inscriptions_public_user_id")
  @@index([formationId], map: "idx_inscriptions_public_formation_id")
  @@index([sessionId], map: "idx_inscriptions_public_session_id")
  @@map("inscriptions_public")
}

model SupportCours {
  id                String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId          String                      @map("tenant_id") @db.Uuid
  formateurId       String                      @map("formateur_id") @db.Uuid
  sessionId         String?                     @map("session_id") @db.Uuid
  formationId       String?                     @map("formation_id") @db.Uuid
  titre             String                      @db.VarChar(255)
  description       String?                     @db.Text
  typeFichier       String?                     @map("type_fichier") @db.VarChar(50)
  fichierUrl        String                      @map("fichier_url") @db.VarChar(500)
  tailleFichier     BigInt?                     @map("taille_fichier")
  visibleApprenants Boolean?                    @default(true) @map("visible_apprenants")
  videoProvider     String?                     @map("video_provider") @db.VarChar(20)
  videoId           String?                     @map("video_id") @db.VarChar(255)
  urlThumbnail      String?                     @map("url_thumbnail") @db.VarChar(500)
  storageProvider   String?                     @map("storage_provider") @db.VarChar(20)
  createdAt         DateTime?                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  formateur         Formateur                   @relation(fields: [formateurId], references: [id])
  session           SessionProfessionnelle?     @relation(fields: [sessionId], references: [id])
  formation         FormationProfessionnelle?   @relation(fields: [formationId], references: [id])
  supportAssociations SupportSessionAssociation[]

  @@map("supports_cours")
}

model SupportSessionAssociation {
  id        String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  supportId String                 @map("support_id") @db.Uuid
  sessionId String                 @map("session_id") @db.Uuid
  createdAt DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  support   SupportCours           @relation(fields: [supportId], references: [id])
  session   SessionProfessionnelle @relation(fields: [sessionId], references: [id])

  @@unique([tenantId, supportId, sessionId], map: "unique_support_session")
  @@map("support_session_associations")
}
