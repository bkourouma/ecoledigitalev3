{
  "name": "@ecoledigitale/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker v2 : relais d'outbox, abonnés d'événements (BullMQ/Redis), jobs planifiés.",
  "main": "./src/index.ts",
  "exports": {
    "./sdk": "./src/sdk.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "migrate": "tsx src/cli/migrate.ts",
    "dlq": "tsx src/cli/dlq.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/with-infra.mjs"
  },
  "dependencies": {
    "@ecoledigitale/database": "workspace:*",
    "@ecoledigitale/kernel": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0",
    "pg": "^8.12.0",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.7",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
