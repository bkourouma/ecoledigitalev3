{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "downlevelIteration": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ecoledigitale/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@ecoledigitale/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@ecoledigitale/ui": [
        "../../packages/ui/src"
      ],
      "@ecoledigitale/utils": [
        "../../packages/utils/src"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "src/__tests__",
    "src/**/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
