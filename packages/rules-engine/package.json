{
  "name": "@ecoledigitale/rules-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur de règles académiques : DSL sandboxé, arithmétique décimale, RuleSets versionnés. Package PUR (zéro I/O).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
