  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant_id}}",
            "type": "text"
          },
          {
            "key": "X-Dev-Auth",
            "value": "1",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "health"]
        }
      },
      "response": []
    },
    {
      "name": "2. Download File - Original Format",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant_id}}",
            "type": "text"
          },
          {
            "key": "X-Dev-Auth",
            "value": "1",
            "type": "text"
          },
          {
            "key": "X-User-Id",
            "value": "{{user_id}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/files/{{tenant_id}}/{{course_id}}/{{filename}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "files", "{{tenant_id}}", "{{course_id}}", "{{filename}}"]
        }
      },
      "response": []
    },
    {
      "name": "3. Download File - Corrected Format",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant_id}}",
            "type": "text"
          },
          {
            "key": "X-Dev-Auth",
            "value": "1",
            "type": "text"
          },
          {
            "key": "X-User-Id",
            "value": "{{user_id}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/files/{{tenant_id}}/{{assignment_id}}/{{filename}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "files", "{{tenant_id}}", "{{assignment_id}}", "{{filename}}"]
        }
      },
      "response": []
    },
    {
      "name": "4. Get Assignment Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant_id}}",
            "type": "text"
          },
          {
            "key": "X-Dev-Auth",
            "value": "1",
            "type": "text"
          },
          {
            "key": "X-User-Id",
            "value": "{{user_id}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/assignments/{{assignment_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "assignments", "{{assignment_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "5. Next.js API Download",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "next-auth.session-token=YOUR_SESSION_TOKEN",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{next_url}}/api/v1/files/download?url=%2Fapi%2Fv1%2Ffiles%2F{{tenant_id}}%2F{{course_id}}%2F{{filename}}&assignmentId={{assignment_id}}",
          "host": ["{{next_url}}"],
          "path": ["api", "v1", "files", "download"],
          "query": [
            {
              "key": "url",
              "value": "/api/v1/files/{{tenant_id}}/{{course_id}}/{{filename}}"
            },
            {
              "key": "assignmentId",
              "value": "{{assignment_id}}"
            }
          ]
        }
      },
      "response": []
    }
  ]
