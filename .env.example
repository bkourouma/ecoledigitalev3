# EcoleDigitale — variables d'environnement (développement local)
#
# Copier ce fichier vers `.env` (racine) ou `apps/api/.env`, puis remplacer chaque
# valeur <...>. Ne JAMAIS committer un vrai .env. Contrôle : `pnpm check:secrets`.
# Générer un secret : openssl rand -base64 48
#
# En NODE_ENV=production, l'API et le web REFUSENT de démarrer si JWT_SECRET /
# NEXTAUTH_SECRET sont absents, de moins de 32 caractères ou égaux à une valeur
# d'exemple (voir apps/api/src/config/env.ts et apps/web/src/lib/env.server.ts).

# Database Configuration (REQUIS — plus aucune URL par défaut dans le code)
DATABASE_URL=postgresql://postgres:<mot-de-passe-postgres>@localhost:5432/dbecoledigitale
DB_MAIN_URL=postgresql://postgres:<mot-de-passe-postgres>@localhost:5432/dbecoledigitale
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<mot-de-passe-postgres>

# API Configuration
API_PORT=4000
API_HOST=0.0.0.0
# REQUIS (>= 32 caractères aléatoires en production)
JWT_SECRET=<secret-aleatoire-32-caracteres-minimum>
JWT_EXPIRES_IN=24h

# Super administrator (global, outside tenants)
SUPER_ADMIN_EMAIL=superadmin@ecoledigitale.local
SUPER_ADMIN_PASSWORD=<mot-de-passe-super-admin>
SUPER_ADMIN_NAME=Super Administrateur
SUPER_ADMIN_JWT_SECRET=<autre-secret-aleatoire-32-caracteres-minimum>

# Comptes techniques (un par rôle et par tenant, ex. admin@<slug>.local)
# Mot de passe commun, identique côté API et côté web (panneau de /login).
# Absent côté API : un mot de passe aléatoire est généré à la création d'un compte
# et affiché UNE SEULE FOIS dans les logs de l'API.
# Les comptes déjà créés ne changent pas : pnpm rotate:technical-passwords -- --yes
TECHNICAL_ACCOUNT_PASSWORD=
# Surcharges de comptes par tenant pour le panneau de /login (JSON, côté web) :
#   {"mon-tenant":{"teacher":{"email":"prenom.nom@exemple.test","password":"<...>"}}}
TECHNICAL_ACCOUNT_OVERRIDES=

# Scripts de démonstration / seeds (infra/scripts/seed*.ts, scripts/create-*.ts…)
SEED_PASSWORD=

# Web Configuration
NEXTAUTH_URL=http://localhost:3000
# REQUIS en production (>= 32 caractères). En développement, s'il est absent, un
# secret aléatoire est généré par process (les sessions sautent au redémarrage).
NEXTAUTH_SECRET=<secret-aleatoire-32-caracteres-minimum>

# Tests e2e Playwright
E2E_ADMIN_PASSWORD=
E2E_TEACHER_PASSWORD=
E2E_STUDENT_PASSWORD=

# OpenAI Configuration
OPENAI_API_KEY=<votre-cle-openai>

# MinIO/S3 Configuration
MINIO_USER=<utilisateur-minio>
MINIO_PASSWORD=<mot-de-passe-minio>
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=ecoledigitale-uploads

# Redis Configuration (for BullMQ)
# Local dev: infra/compose/docker-compose.dev.yml. In docker-compose.yml the API gets redis://redis:6379 (overrides this value).
REDIS_URL=redis://localhost:6379

# LiveKit (videoconferencing)
# Sign up at https://cloud.livekit.io and create a project to get these values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Recordings are uploaded by LiveKit Egress directly to S3/MinIO using the bucket
# below (falls back to MINIO_BUCKET) and the AWS/MinIO credentials defined above.
LIVEKIT_RECORDINGS_S3_BUCKET=ecoledigitale-recordings
LIVEKIT_RECORDINGS_PREFIX=live-sessions/

# NEXT_PUBLIC_LIVEKIT_URL must mirror LIVEKIT_URL — it is read by the web apps so the
# browser can connect directly to LiveKit (only the JWT comes from this API).
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Web (apps/web) - tenant courant
# Ordre de résolution : session > sous-domaine <slug>.ecoledigitale.allianceconsultants.net > NEXT_PUBLIC_TENANT_SLUG.
# Plus AUCUN repli codé en dur : en développement local (localhost, sans sous-domaine), définir le slug du tenant de dev.
# Détails et variables optionnelles : apps/web/ENV_EXAMPLE.md
NEXT_PUBLIC_TENANT_SLUG=

# Environment
NODE_ENV=development

# =============================================================================
# Plateforme v2 (modular monolith) — OPTIONNEL tant que les modules v2 ne sont pas déployés
# =============================================================================
# Sans V2_DATABASE_URL, l'API journalise un avertissement et démarre en mode legacy seul.
#
# Deux rôles Postgres distincts (ADR-002) :
#   - V2_DATABASE_URL  : rôle de CONNEXION de l'application (API, worker). Doit être un rôle LOGIN
#     MEMBRE de `app_user`, ni superuser, ni BYPASSRLS, ni propriétaire des tables. L'API REFUSE de
#     démarrer sinon. Ne jamais y mettre DATABASE_URL (superuser) ni V2_MIGRATOR_URL.
#   - V2_MIGRATOR_URL  : rôle d'administration utilisé UNIQUEMENT par `pnpm db:v2:migrate` et
#     `pnpm db:v2:create-login-role` (création des rôles, DDL). Jamais lu par l'API.
# Les noms de base de développement/test finissent par _dev, _test ou _local (garde-fou du runner de
# migrations : toute autre base exige `pnpm db:v2:migrate -- --yes`).
#
# Mise en route locale :
#   1. créer une base vide (ex. ecoledigitale_v2_dev) et renseigner V2_MIGRATOR_URL ci-dessous ;
#   2. pnpm db:v2:migrate                  (baseline + migrations des modules, ordre topologique) ;
#   3. pnpm db:v2:create-login-role        (affiche UNE SEULE FOIS V2_DATABASE_URL avec un mot de passe
#                                           aléatoire : copiez-le dans votre .env local, non suivi) ;
#   4. pnpm dev:api.
# Contrôles : pnpm check:boundaries (frontières entre modules), pnpm test:isolation (RLS de toutes les tables).
V2_MIGRATOR_URL=postgresql://<role-migrator>:<mot-de-passe-migrator>@localhost:5432/ecoledigitale_v2_dev
V2_DATABASE_URL=postgresql://<role-applicatif-app_user>:<mot-de-passe-genere>@localhost:5432/ecoledigitale_v2_dev
# Optionnel : taille du pool v2 (défaut 10) et délai maximal d'une instruction en ms (défaut 15000).
# V2_DB_POOL_MAX=10
# V2_DB_STATEMENT_TIMEOUT_MS=15000

# --- Worker v2 (apps/worker) : relais d'outbox, abonnes d'evenements, jobs planifies ---
# Role de connexion MEMBRE de app_user (CREATE ROLE <role> LOGIN PASSWORD '...' IN ROLE app_user).
# Jamais un superuser ni le proprietaire des tables : le worker refuse de demarrer s'il est
# SUPERUSER ou BYPASSRLS. N'utilise PAS DATABASE_URL. REDIS_URL (plus haut) est reutilise.
WORKER_DATABASE_URL=postgresql://<role-worker>:<mot-de-passe-worker>@localhost:5432/dbecoledigitale
# Prefixe des cles BullMQ dans Redis (isole plusieurs environnements sur un meme Redis).
WORKER_QUEUE_PREFIX=ed
# Port du serveur de sante (/health, /ready) et niveau de logs (pino).
WORKER_HTTP_PORT=8012
WORKER_LOG_LEVEL=info
# Role de deploiement capable de SET ROLE migrator, pour `pnpm --filter @ecoledigitale/worker migrate`.
# MIGRATOR_DATABASE_URL=postgresql://<role-deploiement>:<mot-de-passe>@localhost:5432/dbecoledigitale

# --- Observabilite (ADR-009, docs/architecture/runbook-exploitation.md) ---------------------------------------
# Tout est OPTIONNEL : sans configuration, aucun appel reseau sortant et aucun /metrics.
# Niveau des journaux JSON (API et worker) : fatal|error|warn|info|debug|trace|silent (defaut info en production).
# LOG_LEVEL=info
# Traces OpenTelemetry : actives SEULEMENT si un point d'acces OTLP/HTTP est defini (profil Docker `observability` : :4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER_ARG=0.1
# Metriques Prometheus : jamais publiques sans authentification. Jeton >= 24 caracteres (openssl rand -hex 24) ;
# un port dedie hors loopback EXIGE le jeton. API : METRICS_PORT (serveur dedie) ou jeton sur le port applicatif ;
# worker : /metrics sur le serveur de sante (jeton obligatoire si WORKER_HTTP_HOST n'est pas en loopback).
# METRICS_TOKEN=<jeton-aleatoire-24-caracteres-minimum>
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1
# Sondes dont l'echec rend /ready non pret (defaut : postgres,redis,migrations ; facultatives : worker, storage).
# OBS_READY_REQUIRE=postgres,redis,migrations

# --- Assemblage v2 (voir docs/architecture/platform-assembly.md) ---------------------------------------------
# OBLIGATOIRES des que V2_DATABASE_URL est defini (demarrage refuse sinon, aucune valeur par defaut) :
#   IAM_JWT_SECRET            >= 32 caracteres aleatoires (openssl rand -base64 48)
#   IAM_MFA_ENCRYPTION_KEY    32 octets en base64 (openssl rand -base64 32)
IAM_JWT_SECRET=<secret-aleatoire-32-caracteres-minimum>
IAM_MFA_ENCRYPTION_KEY=<cle-aes-256-en-base64>
# --- Authentification : bascule legacy -> iam (docs/architecture/auth-cutover.md) -------------------------------
# Les jetons d'acces IAM v2 sont acceptes par les routes LEGACY des que la plateforme v2 est active. Retour arriere : 0.
# V2_LEGACY_IAM_BRIDGE=1
# Date d'EXTINCTION des jetons legacy (ISO 8601 avec fuseau, ex. 2026-12-01 = minuit UTC). Absente : jamais. Malformee :
# demarrage refuse. Apres cette date : jeton legacy refuse (401 LEGACY_TOKEN_SUNSET), login/refresh legacy fermes (410).
# LEGACY_TOKEN_SUNSET=
# Extinction CALCULEE (decision : 90 jours apres la bascule de l'authentification v2). AUTH_CUTOVER_AT = date ISO 8601 de la
# bascule ; extinction = AUTH_CUTOVER_AT + LEGACY_TOKEN_SUNSET_DAYS (defaut 90). Aucune extinction tant que AUTH_CUTOVER_AT
# est absente ; LEGACY_TOKEN_SUNSET explicite reste prioritaire. Malformee : demarrage refuse.
# AUTH_CUTOVER_AT=
# LEGACY_TOKEN_SUNSET_DAYS=90
# Derriere nginx + serveur web : nombre de sauts de proxy de confiance (ou liste de CIDR) pour que le limiteur de debit et
# l'audit voient la vraie adresse du client. Defaut : false (aucun en-tete cru).
# nginx pose X-Forwarded-For = $remote_addr (adresse du client, jamais une chaine fournie par lui) : TRUST_PROXY=1.
# Ne jamais mettre true (X-Forwarded-For falsifiable ; avertissement au demarrage en production).
# TRUST_PROXY=1
# Tolerance (ms, 0 a 30000) des doubles soumissions d'un refresh token (mobile). 0 = rotation stricte.
# IAM_REFRESH_REUSE_GRACE_MS=0
# Connexion Google via iam : secret de service partage avec le serveur web (>= 32 caracteres, MEME valeur cote web).
# Absent : la route /iam/federated-login n'existe pas.
# IAM_SERVICE_SECRET=<secret-aleatoire-32-caracteres-minimum>
# Legacy /auth/social-login : secret partage OBLIGATOIRE en production (MEME valeur cote web, en-tete x-social-login-secret).
# AUTH_SOCIAL_SHARED_SECRET=<secret-aleatoire-32-caracteres-minimum>
# pnpm iam:import-legacy : base legacy lue EN LECTURE SEULE (defaut DATABASE_URL) et mot de passe des comptes techniques.
# LEGACY_DATABASE_URL=postgresql://<role-lecture>:<mot-de-passe>@localhost:5432/dbecoledigitale
# IAM_IMPORT_TECHNICAL_PASSWORD=<mot-de-passe-fort-sans-valeur-par-defaut>
# Chainage HMAC du journal d'audit : MEME valeur pour l'API ET le worker (>= 16 caracteres). Sans elle : SHA-256 simple.
AUDIT_HMAC_KEY=<secret-hmac-audit>
# AUDIT_HMAC_KEY_ID=k1
# AUDIT_HMAC_KEY_PREVIOUS=<ancienne-cle-apres-rotation>   # pour verifier les anciennes lignes
# Detachement des partitions d'audit echues par le job mensuel : `dry-run` (defaut, journalise seulement) ou `apply`.
# AUDIT_DETACH_MODE=dry-run
# Purge des sessions/challenges IAM perimes (jours, defaut 30) par le job quotidien du worker.
# IAM_PURGE_RETENTION_DAYS=30
# Essai accorde a un tenant provisionne (console plateforme ou abonne du worker) : plan et duree en jours.
# ENTITLEMENTS_TRIAL_PLAN=STARTER
# ENTITLEMENTS_TRIAL_DAYS=30
# RATTRAPAGE des tenants legacy au demarrage — HYPOTHESE DE PRODUIT A VALIDER (docs/architecture/platform-assembly.md) :
# V2_LEGACY_TENANT_DEFAULT_PLAN=PROFESSIONAL
# V2_LEGACY_TENANT_DEFAULT_PACK=HIGHER
# V2_LEGACY_TENANT_DEFAULT_COUNTRY=CI
# Finance : environnement des fournisseurs de paiement (development|test|staging|production ; defaut derive de NODE_ENV,
# sinon production = AUCUNE simulation) et URL publique de base des webhooks.
# FINANCE_ENV=production
# FINANCE_WEBHOOK_BASE_URL=https://api.example.org
# Finance : COFFRE DES SECRETS MARCHANDS (spec 015-payments). Les identifiants de paiement (Orange Money, MTN MoMo, Wave,
# CinetPay, TresorPay) se saisissent PAR ETABLISSEMENT dans /v2/finance/providers ; ils sont chiffres (AES-256-GCM) avant
# la base avec une cle maitre de l'ENVIRONNEMENT. Sans cle, la saisie est refusee (aucun repli en clair).
#   Generer une cle : openssl rand -base64 32      Format : <id>:<base64 de 32 octets>[,<id>:<base64>...]
#   Rotation : ajouter la nouvelle cle EN TETE (ou la nommer dans _ACTIVE_KEY), appeler POST /providers/rotate-secrets
#   pour chaque etablissement, puis retirer l'ancienne cle du trousseau.
# FINANCE_SECRETS_KEYS=k1:<base64-32-octets>
# FINANCE_SECRETS_ACTIVE_KEY=k1
# Duree (ms) du cache de configuration des fournisseurs (defaut 15000 ; une desactivation faite par un autre processus
# s'applique au plus tard apres ce delai).
# FINANCE_PROVIDER_CONFIG_CACHE_MS=15000
# Repli sur la configuration d'ENVIRONNEMENT pour un etablissement SANS configuration propre (deploiement
# mono-etablissement uniquement). Defaut : faux hors developpement/test. Attention : l'argent des familles arrive alors
# sur CE compte marchand.
# FINANCE_PROVIDER_ENV_FALLBACK=false
# Points d'acces des fournisseurs (niveau PLATEFORME ; jamais configurables par un etablissement). Defauts : hotes publics
# des fournisseurs. <NOM> = ORANGE_MONEY | MTN_MOMO | WAVE | CINETPAY | TRESORPAY ; TRESORPAY n'a pas d'hote de test connu :
# renseigner FINANCE_PROVIDER_TRESORPAY_SANDBOX_BASE_URL pour tester en sandbox.
# FINANCE_PROVIDER_<NOM>_BASE_URL=https://...
# FINANCE_PROVIDER_<NOM>_SANDBOX_BASE_URL=https://...
# Configuration d'un fournisseur par l'ENVIRONNEMENT (repli mono-etablissement ci-dessus) : FINANCE_PROVIDER_<NOM>_<CLE>
# (cles en minuscules cote code), `mode` = sandbox | production OBLIGATOIRE, refuse en production s'il vaut sandbox.
# FINANCE_PROVIDER_ORANGE_MONEY_MODE=production
# FINANCE_PROVIDER_ORANGE_MONEY_COUNTRY=ci
# FINANCE_PROVIDER_ORANGE_MONEY_CLIENT_ID=<client-id-orange>
# FINANCE_PROVIDER_ORANGE_MONEY_CLIENT_SECRET=<client-secret-orange>
# FINANCE_PROVIDER_ORANGE_MONEY_MERCHANT_KEY=<cle-marchand-orange>
# FINANCE_PROVIDER_ORANGE_MONEY_WEBHOOK_SECRET=<secret-aleatoire-de-notification>
# FINANCE_PROVIDER_MTN_MOMO_MODE=production
# FINANCE_PROVIDER_MTN_MOMO_TARGET_ENVIRONMENT=mtnivorycoast
# FINANCE_PROVIDER_MTN_MOMO_API_USER=<uuid-api-user>
# FINANCE_PROVIDER_MTN_MOMO_API_KEY=<api-key-mtn>
# FINANCE_PROVIDER_MTN_MOMO_SUBSCRIPTION_KEY=<cle-abonnement-mtn>
# FINANCE_PROVIDER_MTN_MOMO_WEBHOOK_SECRET=<secret-aleatoire-de-rappel>
# FINANCE_PROVIDER_WAVE_MODE=production
# FINANCE_PROVIDER_WAVE_API_KEY=<cle-api-wave>
# FINANCE_PROVIDER_WAVE_WEBHOOK_SECRET=<signing-secret-wave>
# FINANCE_PROVIDER_WAVE_WEBHOOK_STRATEGY=signing_secret
# FINANCE_PROVIDER_CINETPAY_MODE=production
# FINANCE_PROVIDER_CINETPAY_SITE_ID=<site-id-cinetpay>
# FINANCE_PROVIDER_CINETPAY_API_KEY=<apikey-cinetpay>
# FINANCE_PROVIDER_CINETPAY_SECRET_KEY=<cle-secrete-cinetpay>
# FINANCE_PROVIDER_CINETPAY_CHANNELS=ALL
# FINANCE_PROVIDER_TRESORPAY_MODE=production
# FINANCE_PROVIDER_TRESORPAY_MERCHANT_ID=<merchant-id-tresorpay>
# FINANCE_PROVIDER_TRESORPAY_API_KEY=<api-key-tresorpay>
# FINANCE_PROVIDER_TRESORPAY_SECRET_KEY=<secret-de-signature-tresorpay>
# FINANCE_PROVIDER_TRESORPAY_WEBHOOK_SECRET=<secret-webhook-tresorpay>
# Liens des e-mails d'invitation / reinitialisation (SMTP_* : memes variables que l'e-mail legacy). Sans SMTP_HOST,
# aucun e-mail n'est envoye (journalise sans le jeton) : le proprietaire invite ne peut pas definir son mot de passe.
# V2_APP_BASE_URL=https://app.example.org
# SMTP_HOST=<hote-smtp>
# SMTP_USER=<utilisateur-smtp>
# SMTP_PASSWORD=<mot-de-passe-smtp>
# Stockage d'objets partage (bulletins PDF, justificatifs de presence, pieces des personnes) : API ET worker.
# S3 / MinIO : renseigner le bucket. Chaque STORAGE_S3_* retombe sur son homologue historique REPORTCARDS_S3_*.
# STORAGE_S3_BUCKET=<bucket>
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_ACCESS_KEY_ID=<cle-d-acces>
# STORAGE_S3_SECRET_ACCESS_KEY=<cle-secrete>
# STORAGE_S3_SSE=AES256
# STORAGE_S3_KMS_KEY_ID=
# STORAGE_S3_PREFIX=
# Repli DISQUE (developpement uniquement, jamais en production) : sans bucket, actif hors production ou si STORAGE_DISK_DIR
# est defini. URL signees HMAC servies par l'API ; fixer le secret si l'API et le worker partagent le disque.
# STORAGE_DISK_DIR=./.data/objects
# STORAGE_PUBLIC_BASE_URL=http://localhost:4000
# STORAGE_SIGNING_SECRET=<secret-aleatoire-16-caracteres-minimum>
# Bulletins : cle privee Ed25519 PKCS#8 de signature (PEM ou chemin d'un secret monte), domaine public de verification
# (repli : V2_APP_BASE_URL) et moteur de rendu PDF du worker.
# REPORTCARDS_SIGNING_KEY=<cle-privee-pkcs8>
# REPORTCARDS_SIGNING_KEY_FILE=
# REPORTCARDS_SIGNING_KEY_ID=
# REPORTCARDS_VERIFICATION_BASE_URL=https://verif.example.org
# REPORTCARDS_CHROME_PATH=
# REPORTCARDS_CHROME_NO_SANDBOX=1
# REPORTCARDS_RENDER_CONCURRENCY=2
# Notifications externes (module notifications, spec v2/016) : API ET worker. Aucun envoi reel en test ; un canal non
# configure echoue EXPLICITEMENT (jamais de simulation silencieuse). Le worker envoie (job notifications.dispatch).
# E-mail : memes SMTP_* que ci-dessus + SMTP_FROM_EMAIL (adresse d'expedition) ; en production, le secret de desinscription
# est obligatoire (liens de desinscription signes + en-tetes List-Unsubscribe).
# SMTP_FROM_EMAIL=<adresse-expediteur>
# SMTP_FROM_NAME=EcoleDigitale
# NOTIFICATIONS_UNSUBSCRIBE_SECRET=<secret-aleatoire-32-caracteres-minimum>
# NOTIFICATIONS_WEBHOOK_SECRET=<secret-hmac-des-accuses-de-fournisseurs>
# NOTIFICATIONS_DEFAULT_SENDER_NAME=EcoleDigitale
# Mode SIMULATION explicite (hors production uniquement, refuse en production) : remises consignees SIMULATED, jamais envoyees.
# NOTIFICATIONS_SIMULATE=0
# Debit : remises traitees par passe et par etablissement, bail d'une remise en cours d'envoi (ms), file maximale par etablissement.
# NOTIFICATIONS_DISPATCH_BATCH=50
# NOTIFICATIONS_LEASE_MS=120000
# NOTIFICATIONS_MAX_PENDING=20000
# SMS : choix du fournisseur. (absent) | http = adaptateur HTTP generique ci-dessous ; orange = Orange SMS API (decision metier 2026-10-02) ;
# none = aucun. Orange reste DESACTIVE tant que ORANGE_SMS_MODE n est pas sandbox (aucun appel reseau, hors production) ou live.
# NOTIFICATIONS_SMS_PROVIDER=orange
# ORANGE_SMS_MODE=disabled
# ORANGE_SMS_CLIENT_ID=<client-id-portail-orange>
# ORANGE_SMS_CLIENT_SECRET=<client-secret-portail-orange>
# ORANGE_SMS_AUTHORIZATION_HEADER=<alternative : en-tete Basic fourni par le portail Orange>
# ORANGE_SMS_SENDER=<numero-expediteur-E164-declare-chez-Orange>
# ORANGE_SMS_SENDER_NAME=<nom-affiche-11-car-max>
# ORANGE_SMS_API_BASE_URL=https://api.orange.com
# ORANGE_SMS_TOKEN_URL=https://api.orange.com/oauth/v3/token
# ORANGE_SMS_TIMEOUT_MS=10000
# ORANGE_SMS_DEFAULT_DIAL_CODE=225
# ORANGE_SMS_ALLOW_INTERNATIONAL=0
# ORANGE_SMS_MAX_SEGMENTS=3
# ORANGE_SMS_UNIT_COST=<cout-entier-XOF-par-segment-si-connu>
# ORANGE_SMS_MAX_PER_MINUTE=0
# ORANGE_SMS_QUOTA_PAUSE_SECONDS=900
# SMS : adaptateur HTTP GENERIQUE (le fournisseur n'est pas choisi, voir specs/v2/016-communications/open-questions.md Q-18).
# Profil de reference : SMS_HTTP_PROFILE=africastalking (a valider avec le fournisseur retenu) ; sinon renseigner le modele.
# SMS_HTTP_PROFILE=generic
# SMS_HTTP_URL=https://api.fournisseur-sms.example/v1/messages
# SMS_HTTP_METHOD=POST
# SMS_HTTP_CONTENT_TYPE=json
# SMS_HTTP_BODY={"to":"{{to}}","message":"{{text}}","from":"{{sender}}","reference":"{{reference}}"}
# SMS_HTTP_HEADERS={"Accept":"application/json"}
# SMS_HTTP_API_KEY=<cle-api-sms>
# SMS_HTTP_API_KEY_HEADER=Authorization
# SMS_HTTP_API_KEY_PREFIX=Bearer
# SMS_HTTP_USERNAME=<identifiant-compte-sms-si-requis>
# SMS_HTTP_SENDER_ID=<expediteur-alphanumerique>
# SMS_HTTP_SUCCESS_PATH=status
# SMS_HTTP_SUCCESS_EQUALS=queued
# SMS_HTTP_ID_PATH=data.messageId
# SMS_HTTP_COST_PATH=data.cost
# SMS_HTTP_COST_MULTIPLIER=1
# SMS_HTTP_COST_CURRENCY=XOF
# SMS_HTTP_ERROR_PATH=error
# SMS_HTTP_TIMEOUT_MS=10000
# WhatsApp : WaSender (memes variables que le legacy ; WHATSAPP_PROVIDER, s'il est defini, doit valoir wasender).
# WASENDER_API_KEY=<cle-api-wasender>
# WASENDER_API_BASE_URL=https://wasenderapi.com/api
# WASENDER_SESSION=<identifiant-de-session>
# WASENDER_SESSION_NAME=<nom-de-session>
# WASENDER_TIMEOUT_MS=10000
# WASENDER_SKIP_STATUS_CHECK=0
# Web Push (VAPID) : generer les cles avec `npx web-push generate-vapid-keys` ; la cle publique est servie aux navigateurs.
# NOTIFICATIONS_VAPID_PUBLIC_KEY=<cle-publique-vapid>
# NOTIFICATIONS_VAPID_PRIVATE_KEY=<cle-privee-vapid>
# NOTIFICATIONS_VAPID_SUBJECT=mailto:support@example.org
