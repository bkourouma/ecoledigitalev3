# Database Configuration
DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/dbecoledigitale
DB_MAIN_URL=postgresql://postgres:mysecretpassword@localhost:5432/dbecoledigitale
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# API Configuration
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=24h

# Super administrator (global, outside tenants)
SUPER_ADMIN_EMAIL=superadmin@ecoledigitale.local
SUPER_ADMIN_PASSWORD=change-this-password
SUPER_ADMIN_NAME=Super Administrateur
SUPER_ADMIN_JWT_SECRET=replace-with-another-32-random-characters

# Web Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# MinIO/S3 Configuration
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=ecoledigitale-uploads

# Redis Configuration (for BullMQ)
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
