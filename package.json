{
  "version": "1.0.0",
  "name": "ecoledigitale",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @ecoledigitale/api dev",
    "dev:web": "pnpm --filter @ecoledigitale/web dev",
    "dev": "concurrently \"pnpm --filter @ecoledigitale/api dev\" \"pnpm --filter @ecoledigitale/web dev\"",
    "seed": "tsx infra/scripts/seed.ts",
    "seed:programmes": "tsx infra/scripts/seed-programmes.ts",
    "seed:v2": "tsx scripts/seed-v2.ts",
    "migrate": "node scripts/run-psql.mjs infra/scripts/migrations/0001_init.sql",
    "migrate:academic": "node scripts/run-psql.mjs infra/scripts/migrations/0002_academic.sql",
    "migrate:assignments": "node scripts/run-psql.mjs infra/scripts/migrations/0018_assignments_refactor.sql",
    "migrate:rso-phase1": "node scripts/migrate-rso-phase1.js",
    "migrate:rso-phase2": "node scripts/migrate-rso-phase2.js",
    "seed:rso-admin": "node scripts/seed-rso-admin.js",
    "seed:rso-phase1": "tsx infra/scripts/seed-rso-phase1.ts",
    "setup:rso-env": "node scripts/create-rso-env.js",
    "setup": "pnpm install && pnpm migrate && pnpm seed",
    "build": "pnpm --filter apps/api build && pnpm --filter apps/web build",
    "clean": "pnpm --filter apps/api clean || true && pnpm --filter apps/web clean || true",
    "lint": "echo \"(optional) add eslint later\"",
    "type-check": "echo \"(optional) add tsc later\"",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test -c apps/web/playwright.auth-v2.config.ts",
    "test:e2e:moyennes": "playwright test --config apps/web/playwright.config.ts apps/web/e2e/moyennes-semestre.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:install": "playwright install",
    "test:api": "node scripts/test-api-endpoints.js",
    "verify:students-visibility": "node scripts/verify-student-registration-visibility.mjs",
    "verify:students-visibility:ecoledigitale": "node scripts/verify-student-registration-visibility.mjs --tenant ecbc1783-19ff-4ada-821f-4345850edcf6",
    "verify:moyennes-semestre": "node scripts/verify-moyennes-semestre.mjs",
    "verify:moyennes-semestre:stack": "node scripts/verify-moyennes-semestre-stack.mjs",
    "test:upload": "node scripts/debug-upload-error.js",
    "test:file-access": "tsx apps/api/scripts/test-report-card-file-access.ts",
    "test:file-routes": "tsx apps/api/scripts/test-file-routes.ts",
    "test:grades-duplicates": "tsx scripts/test-grades-duplicates.ts",
    "check:duplicate-courses": "tsx scripts/check-duplicate-courses.ts",
    "remove:duplicate-course": "tsx scripts/remove-duplicate-course.ts",
    "remove:duplicate-course-direct": "tsx scripts/remove-duplicate-course-direct.ts",
    "remove:duplicate-course-sql": "node scripts/run-psql.mjs scripts/remove-duplicate-course-dv-dash-002.sql",
    "validate": "node scripts/continuous-validation.js",
    "test:assignment-access": "node scripts/test-teacher-assignment-access.js",
    "test:assignment-access:sql": "node scripts/run-psql.mjs scripts/test-assignment-access.sql",
    "migrate:attendance-time-slots": "node scripts/apply-migration-0043.js",
    "migrate:courses-coef-decimal": "node scripts/apply-migration-0054-courses-coef.js",
    "migrate:unified-multitenancy": "node scripts/apply-migration-0055-unified-multitenancy.js",
    "seed:koffi-assignments": "tsx scripts/seed-koffi-teacher-assignments.ts",
    "fix:koffi-assignment-labels": "tsx scripts/fix-koffi-assignment-labels.ts",
    "seed:algebre-pdf-submissions-lprigla": "tsx scripts/seed-remaining-submissions-algebre-pdf-lprigla.ts",
    "remove:technical-parent": "tsx scripts/remove-technical-parent.ts",
    "rotate:technical-passwords": "tsx scripts/rotate-technical-passwords.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "restore:drill": "node infra/scripts/restore-drill.mjs",
    "check:boundaries": "depcruise apps/api/src/modules apps/api/src/platform packages/kernel/src packages/rules-engine/src packages/database/src --config .dependency-cruiser.cjs",
    "db:v2:migrate": "tsx scripts/db/v2-migrate.ts",
    "db:v2:create-login-role": "tsx scripts/db/create-login-role.ts",
    "iam:import-legacy": "tsx scripts/iam/import-legacy.ts",
    "module:new": "tsx scripts/module-new.ts",
    "test:isolation": "node scripts/db/test-isolation.mjs",
    "test:v2": "pnpm --filter @ecoledigitale/api test:v2",
    "test:characterization": "node tests/characterization/run.mjs",
    "test:phase1": "pnpm --filter @ecoledigitale/api test:phase1",
    "test:phase2": "pnpm --filter @ecoledigitale/api test:phase2",
    "test:phase3": "pnpm --filter @ecoledigitale/api test:phase3",
    "test:load": "pnpm --filter @ecoledigitale/api test:load"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser@5": "5.11.2",
      "basic-ftp@5": "5.3.1",
      "axios@1": "1.20.0",
      "js-yaml@4": "4.3.2",
      "lodash@4": "4.18.1",
      "follow-redirects@1": "1.16.1",
      "form-data@4": "4.0.6",
      "ws@8": "8.22.0",
      "nodemailer@7": "7.0.13",
      "jws@3": "3.2.3",
      "glob@10": "10.5.0",
      "tar-fs@3": "3.1.3",
      "tmp@0.2": "0.2.7",
      "preact@10": "10.29.8",
      "picomatch@2": "2.3.2",
      "minimatch@3": "3.1.5",
      "minimatch@5": "5.1.9",
      "minimatch@9": "9.0.9",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "postcss@8": "8.5.28",
      "mammoth@1": "1.13.0",
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "underscore@1": "1.13.8",
      "ip-address@10": "10.7.3",
      "nanoid@5": "5.1.16",
      "nanoid@3": "3.3.19",
      "dompurify@3": "3.4.16",
      "fast-uri@3": "3.1.8",
      "fast-uri@2": "2.4.7",
      "ajv@8": "8.20.0",
      "yaml@2": "2.9.1",
      "postcss-selector-parser@6": "6.1.4",
      "@smithy/config-resolver@4": "4.7.2"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "form-data": "^4.0.4",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.6",
    "concurrently": "^8.2.2",
    "dependency-cruiser": "^18.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
