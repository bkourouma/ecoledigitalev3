{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ecoledigitale/contracts": ["../../packages/contracts/src/index.ts"],
      "@ecoledigitale/contracts/*": ["../../packages/contracts/src/*"],
      "fastify": ["../../apps/api/node_modules/fastify"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["snapshots"]
}
