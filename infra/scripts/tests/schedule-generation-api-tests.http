### 20. Complex Generation Test - Multiple Courses
POST {{baseUrl}}/schedule-generation/generate
Content-Type: application/json
x-tenant: {{tenantId}}

{
  "classId": "{{testClassId}}",
  "selectedCourses": [
    {
      "courseId": "{{$guid}}",
      "requiredHours": 30,
      "preferredSessionDuration": 120,
      "maxSessionsPerWeek": 3
    },
    {
      "courseId": "{{$guid}}",
      "requiredHours": 25,
      "preferredSessionDuration": 90,
      "maxSessionsPerWeek": 2
    },
    {
      "courseId": "{{$guid}}",
      "requiredHours": 20,
      "preferredSessionDuration": 180,
      "maxSessionsPerWeek": 1
    }
  ],
  "availableTimeSlots": [
    "{{$guid}}",
    "{{$guid}}",
    "{{$guid}}",
    "{{$guid}}"
  ],
  "generationPreferences": {
    "balanceWorkload": true,
    "avoidBackToBackSessions": true,
    "preferMorningSlots": false,
    "maxDailyHours": 8,
    "allowWeekendSessions": true
  }
}
