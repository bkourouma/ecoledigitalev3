# EcoleDigitale — production .env
#
# Server location: /home/deployer/ecoledigitale.env  (mode 600, owned by deployer)
# Loaded by docker compose via --env-file (see infra/scripts/deploy.sh).
# NEVER commit a real .env to git.
#
# Optional integration vars (payments, SMTP, Twilio, etc.) — see
# apps/api/ENV_EXAMPLE.md for the full list. Add to this file as needed.

# --- Postgres (container) ---
POSTGRES_DB=dbecoledigitale
POSTGRES_USER=ecoledigitale
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# --- API ---
# Inside the docker network, the API talks to postgres at host "postgres"
DATABASE_URL=postgresql://ecoledigitale:CHANGE_ME_strong_password@postgres:5432/dbecoledigitale
JWT_SECRET=CHANGE_ME_random_64_bytes
CORS_ORIGIN=https://ecoledigitale.allianceconsultants.net
LOG_LEVEL=info

# --- Web (Next.js) ---
NEXTAUTH_URL=https://ecoledigitale.allianceconsultants.net
NEXTAUTH_SECRET=CHANGE_ME_random_64_bytes
# API_INTERNAL_URL is set in docker-compose.yml; do not override here.

# --- MinIO ---
MINIO_USER=ecoledigitale
MINIO_PASSWORD=CHANGE_ME_strong_password

# --- API: SMTP (Hostinger) ---
# Used by both the API and formation-pro-public (shared transport).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=formations@allianceconsultants.net
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=formations@allianceconsultants.net
LEAD_NOTIFY_TO=formations@allianceconsultants.net

# --- formation-pro-public ---
NEXT_PUBLIC_APP_URL=https://formation-pro.allianceconsultants.net
# NEXTAUTH_URL is shared with the ecoledigitale web app above; if you need
# a separate one for formation-pro, that requires per-container env split.
PUBLIC_FORMATION_TENANT_ID=f73f529f-5b1b-4027-877d-d4dc344d081b
FORMATION_PUBLIC_ADMIN_EMAILS=babadkourouma@gmail.com,formations@allianceconsultants.net
# Google OAuth (create at https://console.cloud.google.com — see bootstrap-server.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PayHubSecure (production keys — leave blank to disable)
PAYHUBSECURE_API_KEY=
PAYHUBSECURE_MERCHANT_ID=
PAYHUBSECURE_BASE_URL=https://rest-airtime.paysecurehub.com
PAYHUBSECURE_HUB_URL=https://payx.paysecurehub.com
