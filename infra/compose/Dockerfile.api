# Multi-stage build for the API.
# Production runs via tsx (same runtime as dev) — bypasses the workspace
# layout pain that breaks tsc-emitted dist module resolution.
#
# ATTENTION — le tag Alpine est EPINGLE a 3.19 et ne doit pas etre relache.
# Alpine ne propose qu'une seule version de Chromium par release, et Puppeteer
# 21.11 (apps/api/package.json) parle le protocole CDP de Chrome 121. Mesure
# sur ce serveur, avec un PDF de test :
#
#   Alpine 3.18 -> Chromium 119 : PDF genere en 529 ms
#   Alpine 3.19 -> Chromium 124 : PDF genere en 549 ms
#   Alpine 3.20 -> Chromium 131 : non teste
#   Alpine 3.21 -> Chromium 136 : ECHEC apres 150 s
#                                 « Requesting main frame too early! »
#
# C'est ce dernier cas qui renvoyait un 504 Gateway Time-out a la generation
# d'un bulletin de paie : Chromium demarrait en 535 ms puis Puppeteer restait
# bloque, l'ecart de versions cassant le dialogue CDP.
#
# Passer a une Alpine plus recente suppose donc de monter Puppeteer en meme
# temps (et d'adapter `headless: "new"`, retire apres la v22).
# Node 20 (et non 18) : fastify 5 exige Node >= 20. Le tag Alpine reste 3.19 (voir ci-dessus).
FROM node:20-alpine3.19 AS base
# pnpm est epingle sur la version declaree par `packageManager` dans
# package.json. Sans version, `npm install -g pnpm` sert la derniere publiee :
# pnpm 12 verifie l identite du gestionnaire de paquets et refuse un lockfile v9,
# qui ne contient pas /exe. Le build cassait alors sans qu aucun commit
# n ait bouge — vecu le 27/08/2026 (ERR_PNPM_PNPM_ENGINE_IDENTITY_UNVERIFIABLE).
RUN npm install -g pnpm@10.14.0

# Dependencies stage — install once, share with runner
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/utils/package.json ./packages/utils/
# Plateforme v2 : apps/api en depend (workspace:*) ; sans ces manifestes l'installation figee echoue.
COPY packages/kernel/package.json ./packages/kernel/
COPY packages/database/package.json ./packages/database/
# Cache BuildKit du store pnpm, partage par les trois images via id=pnpm-store
# (meme pnpm-lock.yaml). Sans lui : "reused 0, downloaded 1329" a chaque build,
# le COPY . . de l etape builder invalidant la couche des qu une source change.
# Requiert BuildKit : docker compose build l active (verifie), docker build non
# (buildx absent du serveur).
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked pnpm install --frozen-lockfile

# Production stage
FROM base AS runner
WORKDIR /app

# Chromium pour Puppeteer (PDF : bulletins de paie, releves, attestations,
# recus). Il est installe par apk plutot que telecharge par Puppeteer pour
# deux raisons :
#   1. pnpm bloque les scripts postinstall — « Ignored build scripts: ...
#      puppeteer ... » dans les logs de build — donc le telechargement n'a
#      jamais lieu, d'ou l'erreur « Could not find Chrome (ver. 121.0.6167.85),
#      cache path: /home/nodejs/.cache/puppeteer » en production.
#   2. Le Chrome distribue par Puppeteer est lie a la glibc et ne peut pas
#      s'executer sur Alpine, qui utilise musl : le telecharger ne suffirait
#      donc pas.
# Les polices couvrent le rendu des accents dans les documents francais.
RUN apk add --no-cache \
      chromium \
      nss \
      freetype \
      harfbuzz \
      ca-certificates \
      ttf-freefont \
      font-noto

# Lu par findPuppeteerChromeBinary() (attendance-certificate-template.service.ts
# et les autres services PDF), qui donne la priorite a cette variable.
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_DOWNLOAD=true

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nodejs

# Workspace deps (pnpm symlinks resolve correctly when /app/node_modules,
# /app/apps/*/node_modules and /app/packages/*/node_modules are all in place)
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nodejs:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/utils/node_modules ./packages/utils/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/kernel/node_modules ./packages/kernel/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/database/node_modules ./packages/database/node_modules

# Source — tsx compiles on the fly from these
COPY --chown=nodejs:nodejs package.json pnpm-workspace.yaml ./
COPY --chown=nodejs:nodejs apps/api ./apps/api
COPY --chown=nodejs:nodejs packages/contracts ./packages/contracts
COPY --chown=nodejs:nodejs packages/utils ./packages/utils
COPY --chown=nodejs:nodejs packages/kernel ./packages/kernel
COPY --chown=nodejs:nodejs packages/database ./packages/database

# Point de montage du volume api_uploads (FILE_STORAGE_PATH, voir
# docker-compose.yml). Un volume nomme neuf herite du proprietaire du
# repertoire de l'image : sans ce mkdir/chown il serait root:root et l'API
# (utilisateur nodejs) ne pourrait pas y ecrire.
RUN mkdir -p /app/apps/api/uploads && chown nodejs:nodejs /app/apps/api/uploads

USER nodejs
WORKDIR /app/apps/api

EXPOSE 8011
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8011

CMD ["./node_modules/.bin/tsx", "src/index.ts"]
