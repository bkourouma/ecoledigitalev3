# Multi-stage build for Web (Next.js, pnpm workspace).
# Production runs `next start` against the full node_modules tree —
# Next's standalone output gets corrupted by pnpm's symlink layout
# (next/* package files don't get traced).
FROM node:18-alpine AS base
# Pinned to the version declared by `packageManager` in package.json. An
# unpinned install pulls whatever npm publishes that day, and pnpm 12 refuses a
# v9 lockfile it cannot verify /exe against — the build then breaks with no
# commit having moved (hit on 2026-08-27).
RUN npm install -g pnpm@10.14.0

# Dependencies — installed once, shared with builder + runner
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/ui/package.json ./packages/ui/
COPY packages/utils/package.json ./packages/utils/
# Cache BuildKit du store pnpm, partage par les trois images via id=pnpm-store
# (meme pnpm-lock.yaml). Sans lui : "reused 0, downloaded 1329" a chaque build,
# le COPY . . de l etape builder invalidant la couche des qu une source change.
# Requiert BuildKit : docker compose build l active (verifie), docker build non
# (buildx absent du serveur).
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked pnpm install --frozen-lockfile

# Build — produces apps/web/.next/
FROM base AS builder
WORKDIR /app
COPY . .
COPY --from=deps /app/node_modules ./node_modules
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked pnpm install --frozen-lockfile
RUN pnpm --filter @ecoledigitale/web build

# Runtime
FROM base AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nodejs

# Workspace deps (the symlink farm needs ALL of these or pnpm resolution breaks)
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nodejs:nodejs /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/ui/node_modules ./packages/ui/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/utils/node_modules ./packages/utils/node_modules

# Source needed at runtime: package manifests, web's built .next, transpiled workspace pkgs
COPY --chown=nodejs:nodejs package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=nodejs:nodejs apps/web/package.json ./apps/web/
COPY --from=builder --chown=nodejs:nodejs /app/apps/web/.next ./apps/web/.next
# Static assets served by `next start` (logos, images, favicon…) — must be
# copied explicitly, they are NOT part of .next.
COPY --chown=nodejs:nodejs apps/web/public ./apps/web/public
COPY --chown=nodejs:nodejs apps/web/next.config.js ./apps/web/next.config.js
COPY --chown=nodejs:nodejs packages ./packages

USER nodejs
WORKDIR /app/apps/web

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["./node_modules/.bin/next", "start", "-p", "3000"]
