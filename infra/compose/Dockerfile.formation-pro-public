# Multi-stage build for formation-pro-public (Next.js, pnpm workspace, prisma).
# Production runs `next start` against the full node_modules tree (same
# pattern as ecoledigitale-web — pnpm symlinks break Next standalone).
FROM node:18-alpine AS base
RUN npm install -g pnpm

# Dependencies — install once for layer cache reuse
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/formation-pro-public/package.json ./apps/formation-pro-public/
COPY apps/api/package.json ./apps/api/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/utils/package.json ./packages/utils/
COPY packages/ui/package.json ./packages/ui/
RUN pnpm install --frozen-lockfile

# Build — generates Prisma client (into the pnpm store) then runs next build
FROM base AS builder
WORKDIR /app
COPY . .
COPY --from=deps /app/node_modules ./node_modules
RUN pnpm install --frozen-lockfile
RUN cd apps/formation-pro-public && \
    pnpm exec prisma generate --schema ../api/prisma/schema.prisma
RUN pnpm --filter @ecoledigitale/formation-pro-public build

# Runtime — copy node_modules from the BUILDER stage so the prisma-
# generated files in node_modules/.pnpm/@prisma+client.../ travel with us.
FROM base AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nodejs

COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/apps/formation-pro-public/node_modules ./apps/formation-pro-public/node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages/utils/node_modules ./packages/utils/node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages/ui/node_modules ./packages/ui/node_modules

COPY --chown=nodejs:nodejs package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=nodejs:nodejs apps/formation-pro-public/package.json ./apps/formation-pro-public/
COPY --chown=nodejs:nodejs apps/formation-pro-public/next.config.js ./apps/formation-pro-public/
COPY --chown=nodejs:nodejs apps/formation-pro-public/public ./apps/formation-pro-public/public
COPY --chown=nodejs:nodejs apps/api/prisma ./apps/api/prisma
COPY --from=builder --chown=nodejs:nodejs /app/apps/formation-pro-public/.next ./apps/formation-pro-public/.next
COPY --chown=nodejs:nodejs packages ./packages

USER nodejs
WORKDIR /app/apps/formation-pro-public

EXPOSE 3001

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

CMD ["./node_modules/.bin/next", "start", "-p", "3001"]
