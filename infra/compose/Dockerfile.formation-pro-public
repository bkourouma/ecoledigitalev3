# Multi-stage build for formation-pro-public (Next.js, pnpm workspace, prisma).
# Production runs `next start` against the full node_modules tree (same
# pattern as ecoledigitale-web — pnpm symlinks break Next standalone).
FROM node:18-alpine AS base
RUN npm install -g pnpm

# Dependencies — install once, share with builder + runner
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/formation-pro-public/package.json ./apps/formation-pro-public/
COPY apps/api/package.json ./apps/api/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/utils/package.json ./packages/utils/
COPY packages/ui/package.json ./packages/ui/
RUN pnpm install --frozen-lockfile

# Build — generates Prisma client then runs next build
FROM base AS builder
WORKDIR /app
COPY . .
COPY --from=deps /app/node_modules ./node_modules
RUN pnpm install --frozen-lockfile
# The schema lives under apps/api/prisma/ (shared with the API)
RUN cd apps/formation-pro-public && \
    pnpm exec prisma generate --schema ../api/prisma/schema.prisma
RUN pnpm --filter @ecoledigitale/formation-pro-public build

# Runtime
FROM base AS runner
WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nodejs

# Workspace deps (full pnpm symlink farm)
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nodejs:nodejs /app/apps/formation-pro-public/node_modules ./apps/formation-pro-public/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/utils/node_modules ./packages/utils/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages/ui/node_modules ./packages/ui/node_modules

# Source needed at runtime (manifests, .next build, prisma generated client, ui pkgs)
COPY --chown=nodejs:nodejs package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=nodejs:nodejs apps/formation-pro-public/package.json ./apps/formation-pro-public/
COPY --chown=nodejs:nodejs apps/formation-pro-public/next.config.js ./apps/formation-pro-public/
COPY --chown=nodejs:nodejs apps/formation-pro-public/public ./apps/formation-pro-public/public
COPY --from=builder --chown=nodejs:nodejs /app/apps/formation-pro-public/.next ./apps/formation-pro-public/.next
# Prisma client: generated into the workspace's node_modules during build
COPY --from=builder --chown=nodejs:nodejs /app/apps/formation-pro-public/node_modules/.prisma ./apps/formation-pro-public/node_modules/.prisma
COPY --from=builder --chown=nodejs:nodejs /app/apps/formation-pro-public/node_modules/@prisma ./apps/formation-pro-public/node_modules/@prisma
COPY --chown=nodejs:nodejs packages ./packages

USER nodejs
WORKDIR /app/apps/formation-pro-public

EXPOSE 3001

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

CMD ["./node_modules/.bin/next", "start", "-p", "3001"]
